NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxx
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# Clé service_role Supabase (Project Settings → API → service_role) — jamais
# préfixée par NEXT_PUBLIC_, jamais exposée au navigateur. Utilisée par le
# webhook de paiement, qui n'a pas de session utilisateur.
SUPABASE_SERVICE_ROLE_KEY=xxxxxx

# FedaPay (agrégateur béninois : MTN Mobile Money, Moov Money, carte bancaire)
# Clés sandbox/live disponibles dans FedaPay → Workbench → API Keys.
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxx
FEDAPAY_ENVIRONMENT=sandbox
# Secret propre à l'endpoint webhook, visible dans FedaPay → Webhooks → votre endpoint.
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxx
